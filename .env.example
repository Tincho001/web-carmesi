# Copiar como .env (en el servidor) y completar.
PORT=3200
HOST=127.0.0.1
# Carpeta de datos FUERA de la carpeta del deploy, para que no se borre al actualizar.
DATA_DIR=/var/www/carmesi-data
# Contraseñas iniciales (solo se usan la primera vez que arranca; después se cambian desde el panel).
INIT_PASS_ADMIN=
INIT_PASS_VALENTINA=
